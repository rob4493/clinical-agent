# ─────────────────────────────────────────────────────────────────────────────
# Clinical Decision-Support Agent — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Current health/tests need no real .env or IBM credentials.
# Offline-tested language adapter exists; live integration, admin and audit remain planned.
# Never commit .env to version control.
CLINICAL_RUNTIME_MODE=standard
# Exact modes: standard, synthetic, competition, production.
# Competition composition uses separately eligible evidence; production stays closed.
# Existing CLINICAL_DEMO_MODE=true remains a synthetic-only compatibility opt-in.
# Do not add real credentials, patient data, or model names to this file.
# ─────────────────────────────────────────────────────────────────────────────

# ── IBM watsonx.ai ────────────────────────────────────────────────────────────
LANGUAGE_PROVIDER=disabled
# Competition selects the configured adapter; disabled returns ProviderUnavailable.
# Your IBM watsonx.ai API key (required for production).
WATSONX_API_KEY=

# Set exactly one reviewed project or space UUID when selecting watsonx.
WATSONX_PROJECT_ID=
WATSONX_SPACE_ID=

# IBM watsonx.ai regional endpoint URL.
# Explicit official regional base URL and IAM token endpoint; no assumed adapter URL.
WATSONX_URL=
WATSONX_IAM_URL=
# Explicit supported YYYY-MM-DD API version; do not automatically use today's date.
WATSONX_API_VERSION=
WATSONX_TIMEOUT=10
WATSONX_DEADLINE=30
WATSONX_RETRIES=0
WATSONX_MAX_TOKENS=1024
WATSONX_TEMPERATURE=0
WATSONX_REFRESH_MARGIN=60

# ── Model identifiers ─────────────────────────────────────────────────────────
# Foundation model used for clinical response generation.
WATSONX_LLM_MODEL_ID=

# Embedding model used to encode KB chunks and case queries.
WATSONX_EMBEDDING_MODEL_ID=

# Dimension of vectors produced by the embedding model.
# Must match the Milvus collection schema.
# No dimension is assumed. The planned adapter must resolve and validate it
# at startup or fail retrieval startup.
# If you set this explicitly, it must be a positive integer matching your model's output.
# Use a validated model-specific dimension; no numeric default exists.
# WATSONX_EMBEDDING_DIMENSION=

# ── Milvus vector store ───────────────────────────────────────────────────────
# Adapter construction is explicit and requires an injected client.
# Legacy host/port/collection aliases are retained for compatibility;
# the injected adapter does not use them or construct connections.
# Hostname of the Milvus instance.
# For local Docker sidecar use "localhost"; in Docker Compose use the service name.
MILVUS_HOST=localhost

# Port of the Milvus instance (default gRPC port).
MILVUS_PORT=19530

# Name of the Milvus collection that stores approved KB chunks.
MILVUS_COLLECTION_NAME=knowledge_chunks

# Explicit adapter namespace; no assumed prefix or embedding dimension.
# MILVUS_PREFIX=
MILVUS_METRIC=COSINE
MILVUS_INDEX_TYPE=FLAT
MILVUS_TIMEOUT=30

# ── Administrative access ─────────────────────────────────────────────────────
# Secret passed in the X-Admin-Key header for all /v1/admin/* endpoints.
# Required when the planned admin API exists; not needed for health/tests.
ADMIN_API_KEY=

# ── Audit logging ─────────────────────────────────────────────────────────────
# Future append-only audit log path; no audit persistence exists now.
# Contains event metadata only — never case text, clinical passages, or identifiers.
AUDIT_LOG_PATH=audit.jsonl

# ── PII safeguard filter ──────────────────────────────────────────────────────
# Set to false only for local development where the filter is not needed.
# Must be true in any environment that processes clinician submissions.
PII_FILTER_ENABLED=true

# Additional regex safeguards, as a JSON array of strings. Defaults remain active.
# Empty means use the built-in patterns only. Invalid patterns fail configuration.
PII_FILTER_PATTERNS=[]

# ── Application behaviour ─────────────────────────────────────────────────────
# Must be false in any environment accessible to users.
DEBUG=false

# Local app metadata. Python 3.12 is the supported runtime.
APP_TITLE=Clinical Evidence Assistant
APP_VERSION=0.1.0

# Exact lowercase true is required to opt into fictional, nonclinical demo composition.
CLINICAL_DEMO_MODE=false
# Explicit loopback development origins; no wildcards, credentials or external hosts.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:4173","http://127.0.0.1:4173"]

# Module configuration root (optional). Omit to use backend/app/modules.
# Must be an existing dedicated directory; invalid configs prevent app creation.
# MODULE_ROOT=path/to/reviewed/modules
# Source-free standard/synthetic startup uses inactive metadata-only configurations.
# MODULE_ROOT=backend/releaseModules
# Competition private mount: both values must reference the same verified installation.
# MODULE_ROOT=/private/evidence/backend/app/modules
# CLINICAL_EVIDENCE_ROOT=/private/evidence
# Do not set CLINICAL_EVIDENCE_ROOT to an empty string or a relative path.
